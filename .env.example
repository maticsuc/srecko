# PostgreSQL Database Configuration
# Option 1: Single connection string (Supabase / production)
# Use port 5432 (direct), NOT 6543 (pooler) — hybrid_search() needs session mode
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Option 2: Individual vars (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=srecko_kosovel
DB_USER=srecko_user
DB_PASSWORD=sreckokosovel

# LLM Provider Configuration
# Options: "ollama", "openrouter", "github-copilot", or "github"
LLM_PROVIDER=ollama

# Ollama Configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
# Timeout in seconds for Ollama API requests (increase for larger/slower models)
# Default: 600s for chat, 300s for embeddings
# OLLAMA_CHAT_TIMEOUT=600
# OLLAMA_EMBEDDING_TIMEOUT=300

# OpenRouter Configuration (if LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Other options: anthropic/claude-3.5-sonnet, openai/gpt-4, meta-llama/llama-3.1-70b-instruct
# Note: Free models often have rate limits. Check https://openrouter.ai/models for available models

# GitHub Copilot Configuration (if LLM_PROVIDER=github-copilot)
# GitHub Copilot HAS Claude models!
GITHUB_TOKEN=your_github_token_here
GITHUB_COPILOT_MODEL=Claude Sonnet 4.5
# Available models (use spaces in names):
# - Claude Sonnet 4.6 (newest)
# - Claude Sonnet 4.5 (recommended)
# - Claude Opus 4.6 (most capable)
# - GPT-5.4, Gemini 2.5 Pro
# Get your token from: https://github.com/settings/tokens
# Docs: https://docs.github.com/en/copilot

# GitHub Models Configuration (if LLM_PROVIDER=github)
GITHUB_MODEL=gpt-4o
# IMPORTANT: GitHub Models does NOT have Claude!
# Available models: gpt-4o, gpt-4o-mini, Meta-Llama-3.1-405B-Instruct
# For Claude, use LLM_PROVIDER=github-copilot
# Docs: https://github.com/marketplace/models

# Embedding Configuration
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=10

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Optional: Supabase (for future deployment)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_KEY=your_supabase_key_here
